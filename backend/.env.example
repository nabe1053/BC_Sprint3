# このファイルをコピーして .env を作る（.env は git 管理外）
# cp .env.example .env

# Database（docker-compose の POSTGRES_* と一致させる）
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/octg_db

# Application
DEBUG=True
APP_NAME=OCTG Item List Agent API

# CORS（ローカル Next.js のみ）
ALLOWED_ORIGINS=["http://localhost:3000"]

# Claude Agent SDK（Slice 0-7。Anthropic Console で発行）
# 未設定でもアプリは起動する。疎通テストのみキーが必要。
# ANTHROPIC_API_KEY=sk-ant-...

# 認証は実装しない（CLAUDE.md 決定事項1）
